# This is a single-page React app — every "page" (/booking, /provider,
# /admin, /fleet/economy, etc.) only really exists as a client-side route
# inside index.html; there's no actual /provider file on the server.
#
# Without this file, a hard refresh (or typing/bookmarking a URL directly)
# sends a real request straight to the Hostinger web server for that exact
# path. Since no such file exists, Hostinger's own 404 page answers instead
# of the app ever getting a chance to load and hand off to React Router.
#
# This rule tells Apache: for any request that isn't a real file or folder
# already on disk (i.e. not one of the built JS/CSS/image assets), just
# serve index.html instead. React Router then reads the URL and renders the
# right page client-side, exactly as if you'd navigated there normally.
# Never redirect /services -> /services/ — the build step writes a
# services.html next to a services/ folder (for /services/<slug> pages), and
# without this Apache would send the bare /services URL to the folder.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: blackstonechauffeur.co.nz -> www.blackstonechauffeur.co.nz
  # (one permanent 301, so Google treats www as the only version of the site).
  RewriteCond %{HTTP_HOST} ^blackstonechauffeur\.co\.nz$ [NC]
  RewriteRule ^ https://www.blackstonechauffeur.co.nz%{REQUEST_URI} [L,R=301]

  # Leave real API calls alone if they're ever proxied through this same
  # domain instead of a separate API subdomain — harmless no-op otherwise.
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # /fleet has no page of its own (the app redirects it to the luxury fleet),
  # but the build creates a real /fleet/ folder for the vehicle pages — which
  # Apache answers with 403 Forbidden. Send it to the right page instead.
  RewriteRule ^fleet/?$ /fleet/luxury [L,R=301]

  # /services/ -> /services (and the same for any pre-rendered page) so there
  # is one URL per page instead of a folder-style duplicate.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Pre-rendered pages: the build step (scripts/seoPrerender.js) writes a
  # static <route>.html for every public page, with that page's own title,
  # description and heading already in the HTML. Serve it for /<route> so
  # crawlers get real content without running JavaScript.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # Already-existing files (JS, CSS, images, favicon, etc.) are served
  # as-is. Folders are deliberately NOT served directly: a folder with no
  # index file answers 403 Forbidden, so any folder URL falls through to the
  # app below instead.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else falls back to index.html.
  RewriteRule ^ /index.html [L]
</IfModule>
