PORT=5050
CLIENT_URL=http://localhost:5173

# MySQL connection. For local dev, install MySQL and create the database
# once: mysql -u root -p -e "CREATE DATABASE blackstone"
# Schema + demo data are applied automatically on server start (see db/index.js).
# On hPanel, use the DB host/user/password/name shown in hPanel > Databases
# after creating a MySQL database there (host is usually "localhost" if the
# app runs on the same hPanel hosting).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blackstone

JWT_SECRET=replace-with-a-long-random-secret

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=replace-with-brevo-smtp-user
BREVO_SMTP_PASS=replace-with-brevo-smtp-key
MAIL_FROM=BlackStone Chauffeur <no-reply@blackstonechauffeur.co.nz>
ADMIN_EMAIL=admin@blackstonechauffeur.co.nz

# Google Reviews (Home page "What Riders Say" section). Place ID is already
# set to the business's real listing. GOOGLE_PLACES_API_KEY still needs to
# be filled in with a Google Cloud API key that has "Places API" enabled —
# until then, the /api/reviews endpoint responds with configured: false and
# the site quietly falls back to the placeholder testimonials.
GOOGLE_PLACE_ID=ChIJ89UghFtCzAARBXj36cQzsYA
GOOGLE_PLACES_API_KEY=replace-with-your-google-places-api-key
